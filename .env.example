# ── Trading Mode ───────────────────────────────────────────────────────────────
PAPER_MODE=true
PAPER_BALANCE=10000.0

# ── AI Model ───────────────────────────────────────────────────────────────────
# Choices: claude | openai | gemini
AI_MODEL=claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
# Optional model overrides (defaults: claude-sonnet-4-5 / gpt-4o / gemini-3-flash)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# ── Polymarket ─────────────────────────────────────────────────────────────────

POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
POLY_PRIVATE_KEY=
# Optional: your Polymarket proxy wallet address (from your profile page).
# Only needed if your signing key differs from your trading wallet.
# Live trading requires the official SDK: pip install polymarket-client
POLY_WALLET_ADDRESS=

# ── Copy Trading ───────────────────────────────────────────────────────────────
COPY_TRADING_ENABLED=true
COPY_SCALE_FACTOR=0.1
MAX_COPY_TRADERS=10

# ── Risk Management ────────────────────────────────────────────────────────────
MIN_EDGE_PERCENT=5.0
MAX_BET_SIZE=100.0
MAX_DAILY_SPEND=500.0
MIN_VOLUME=1000.0
AUTO_EXECUTE=false

# ── Scheduling ─────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
COPY_POLL_INTERVAL_MINUTES=5

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
